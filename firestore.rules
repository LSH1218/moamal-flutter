rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(sessionCode) {
      return signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionCode))
               .data.ownerUid == request.auth.uid;
    }

    match /sessions/{sessionCode} {
      // 단건 조회만 허용한다. 목록(list) 조회를 열어두면 인증만 된 사용자가
      // 모든 교사의 세션 코드·제목·ownerUid를 훑을 수 있다 (Common-Rules-03).
      // 앱은 세션 코드로 단건 get·snapshots만 사용하므로 동작 영향이 없다.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;

      match /ideas/{ideaId} {
        // 읽기: 세션에 접속한 인증 사용자 (교사·학생 공통)
        allow read: if signedIn();
        // 생성: 본인 UID를 authorUid로 기록한 문서만
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        // 수정: 교사 또는 작성자 본인만. authorUid 자체는 변경 불가
        // (authorUid가 없는 구 문서는 교사만 수정 가능)
        allow update: if isOwner(sessionCode)
                      || (signedIn()
                          && resource.data.authorUid == request.auth.uid
                          && request.resource.data.authorUid
                             == resource.data.authorUid);
        // 삭제: 교사만
        allow delete: if isOwner(sessionCode);
      }

      match /votes/{participantId} {
        allow read: if isOwner(sessionCode)
                    || (signedIn() && request.auth.uid == participantId);
        allow create, update: if signedIn()
                               && request.auth.uid == participantId;
        allow delete: if isOwner(sessionCode);
      }

      match /approvedGroups/{groupId} {
        // 읽기: 인증된 모든 참가자 (학생 투표 화면에서 구독)
        allow read: if signedIn();
        // 쓰기: 교사만 (Functions Admin SDK는 규칙 우회)
        allow create, update, delete: if isOwner(sessionCode);
      }

      match /participants/{uid} {
        // 읽기: 교사(전체 명단) 또는 본인 문서
        allow read: if isOwner(sessionCode)
                    || (signedIn() && request.auth.uid == uid);
        // 입장: 본인 문서만 생성·수정 가능, 교사는 forceStop 제어용으로 수정 가능
        allow create, update: if (signedIn() && request.auth.uid == uid)
                               || isOwner(sessionCode);
        // 삭제: 교사만 (세션 정리용)
        allow delete: if isOwner(sessionCode);
      }

      match /teacher_notes/{noteId} {
        // 읽기: 인증된 모든 참가자 (학생 화면에서 교사 발화 표시 용도)
        allow read: if signedIn();
        // 쓰기: 교사만
        allow create, update, delete: if isOwner(sessionCode);
      }

      match /mergeLogs/{logId} {
        // 병합 이력 — 교사만 접근
        allow read, write: if isOwner(sessionCode);
      }
    }

    // 교사 화이트리스트 — 로그인한 사용자만 본인 문서 읽기 가능, 쓰기는 Admin SDK만
    match /whitelisted_teachers/{docId} {
      allow read: if signedIn()
                  && (request.auth.token.email == docId
                      || request.auth.uid == docId);
      allow write: if false;
    }

    // STT rate limit 문서 — Cloud Functions Admin SDK만 접근, 클라이언트 완전 차단
    match /sttRateLimits/{doc} {
      allow read, write: if false;
    }

    // Gemini rate limit 문서 — Cloud Functions Admin SDK만 접근, 클라이언트 완전 차단
    match /geminiRateLimits/{doc} {
      allow read, write: if false;
    }

    // OpenAI rate limit 문서 — Cloud Functions Admin SDK만 접근, 클라이언트 완전 차단
    match /openaiRateLimits/{doc} {
      allow read, write: if false;
    }
  }
}
