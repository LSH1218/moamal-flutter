{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "headers": [
      {
        "source": "**",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "moamal-1e601",
          "configurations": {
            "web": "1:58714583922:web:550f045d9fc8027149e3eb"
          }
        }
      }
    }
  }
}
